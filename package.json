{
  "name": "@ricsam/react-mui-calendar",
  "version": "0.1.1",
  "description": "Accessible, themeable month and week calendar components for React and Material UI.",
  "keywords": [
    "react",
    "calendar",
    "material-ui",
    "mui",
    "month-view",
    "week-view",
    "typescript"
  ],
  "homepage": "https://github.com/ricsam/calendar#readme",
  "bugs": {
    "url": "https://github.com/ricsam/calendar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricsam/calendar.git"
  },
  "license": "MIT",
  "author": "Sam Ricks",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsup",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "npx mint@latest dev docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:lib && changeset publish",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "date-fns": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.6",
    "@mui/material": "^7.3.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "date-fns": "^4.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
